# Copy to .env before running `docker compose up`

# Required for PDF data extraction (the rest of the app works without it)
OPENAI_API_KEY=your_openai_api_key

# Optional overrides
# OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible endpoint, e.g. Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_BASE_URL=
# JWT_SECRET=generate-with-openssl-rand-hex-32
