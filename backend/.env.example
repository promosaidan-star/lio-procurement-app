# Database
# Uses psycopg 3 driver. In docker-compose the host is the "db" service.
DATABASE_URL=postgresql+psycopg://asklio:asklio@localhost:5432/asklio

# Auth
# Generate a strong secret for production, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
# Optional: any OpenAI-compatible endpoint. Example for Gemini's free tier:
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_API_KEY=<your Gemini key>   OPENAI_MODEL=gemini-2.5-flash
# OPENAI_BASE_URL=

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3200
